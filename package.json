{
  "name": "chroviewer",
  "private": true,
  "license": "GPL-2.0-only",
  "type": "module",
  "scripts": {
    "start": "HOST=0.0.0.0 PORT=4000 node .output/server/index.mjs",
    "prepare": "vp config --no-agent",
    "api:generate": "node scripts/codegen/generate-api.ts",
    "api:regen": "node scripts/codegen/generate-api.ts --refresh",
    "api:check": "node scripts/codegen/generate-api.ts --check",
    "proto:generate": "node scripts/codegen/generate-live-protocol.ts",
    "proto:check": "node scripts/codegen/generate-live-protocol.ts --check && buf lint src/modules/live/proto",
    "verify": "vp check && vp run api:check && vp run proto:check && vp test && vp build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@resvg/resvg-js": "2.6.2",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/react-query": "5.100.5",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "@wasm-audio-decoders/ogg-vorbis": "^0.1.20",
    "better-result": "2.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.24.0",
    "lzma-web": "^3.0.1",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.7",
    "satori": "^0.28.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "troika-three-text": "^0.52.4",
    "tw-animate-css": "^1.4.0",
    "use-intl": "^4.13.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.71.0",
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-rsc": "^0.5.26",
    "nitro": "^3.0.260522-beta",
    "swagger-typescript-api": "13.9.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=11.20.0 <12"
  },
  "packageManager": "pnpm@11.20.0"
}
